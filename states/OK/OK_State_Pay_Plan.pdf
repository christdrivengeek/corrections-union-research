<div class="newsfeed newsfeed--withimage aem-GridColumn--default--none aem-GridColumn--phone--none aem-GridColumn--phone--12 aem-GridColumn aem-GridColumn--default--12 aem-GridColumn--offset--phone--0 aem-GridColumn--offset--default--0">

   <h2>OMES Latest News</h2>

<div>
   <!-- Handlebar Template Container -->
   <div class="newslist__template" data-template-id="newsfeed_copy-data" data-newsfeedapiurl="/content/sok-wcm/en/omes/jcr:content/responsivegrid-second/container_1670541716/newsfeed_copy.json"></div>
   <!-- No Data -->
   <div class="newsfeed__nodata hidden">
      <p>No Data</p>
   </div>
   <!-- View more -->
   <div class="newsfeed__more">
      <a href="/omes/omes-media/press.html">Full Newsroom</a>
   </div>
</div>
<!-- Handlebar Databinding Script-->
<script id="newsfeed_copy-data" type="text/x-handlebars-template">
   {{#each values}}
   <div class="newsfeed__list">
   {{#if this.thumbnail }}
   {{#if this.isExternal}}
    <a href="{{this.newsUrl}}" class="newsfeed__image" target="_blank" aria-label="Link to {{this.newsUrl}}">
   {{else}}
   <a href="{{this.newsUrl}}" class="newsfeed__image" aria-label="Link to {{this.newsUrl}}">
   {{/if}}
   		<img src="{{ this.thumbnail }}"                  
   				alt="{{this.newsAltText}}">
   </a>
   {{/if}}
   
   		  <div class="newsfeed__content">
   {{#if this.agency}} 
   {{#if this.category}} 
            <div>
               <span class="caption">{{this.category}}</span> | 
            </div>
   {{/if}}
            <div>
               <span class="caption"> {{this.agency}}</span>
            </div>
   {{else}}
   {{#if this.category}} 
            <div>
               <span class="caption">{{this.category}}</span>
            </div>
   {{/if}}
   {{/if}}
   		
   	  
     <h2 class="newsfeed__title">
     {{#if this.isExternal}}
   	<a href="{{this.newsUrl}}" target="_blank">
   	{{else}}
   	<a href="{{this.newsUrl}}">
   	{{/if}}
   		  {{this.title}}  
   	</a>
        </h2>
   			  <div class="caption">
   				 {{ this.lastModified }}
   			  </div>
   		  </div>
   </div>
   {{/each}}
</script></div>

    
</div>

    </div>

    
</div>
